{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["../../packages/**/*", "renderer/**/*", "preload/*.d.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@projector/*": ["renderer/*"],
      "~/*": ["../../packages/*"]
    }
  }
}
